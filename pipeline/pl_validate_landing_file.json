{
	"name": "pl_validate_landing_file",
	"properties": {
		"activities": [
			{
				"name": "Get_File_Metadata",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_adls_csv_parameterized",
						"type": "DatasetReference",
						"parameters": {
							"fileSystem": {
