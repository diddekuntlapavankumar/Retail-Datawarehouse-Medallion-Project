						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"parameters": {
			"p_file_system": {
				"type": "string"
			},
			"p_directory": {
				"type": "string"
			},
			"p_file_name": {
				"type": "string"
			},
			"p_delimiter": {
				"type": "string"
			}
		},
		"annotations": []
	}
